# ── Academia AI Frontend (Next.js) ─────────────────────────────────────────────

# Backend API URL (deployed Render backend URL)
# e.g. NEXT_PUBLIC_API_URL=https://academia-ai-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk authentication keys (from https://dashboard.clerk.com)
# Publishable key is public and safe to expose
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
